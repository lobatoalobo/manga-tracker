generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  shareSlug     String?   @unique // si está seteado, la colección es pública en /u/<slug>
  // Serie preferida (1 por usuario): se fija 1ra en la colección (propia y
  // compartida) con highlight dorado. Guarda el anilistId (negativo si es nacional).
  favoriteAnilistId Int?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  mangas    Manga[]
  purchases Purchase[]
  wishlist  WishlistItem[]
  notes     UserNote[]

  friendsRequested  Friendship[]       @relation("requester")
  friendsReceived   Friendship[]       @relation("addressee")
  activities        Activity[]
  activityComments  ActivityComment[]
  activityReactions ActivityReaction[]
  notifications     Notification[]
  notifPref         NotificationPref?
  pushSubs          PushSubscription[]
  seriesMutes       SeriesNotifMute[]
  // Retail: membresías comerciales (OWNER/STAFF) de tiendas que administra. Relación VIRTUAL (la FK vive
  // en StoreMember.userId); no agrega columnas a User. Ver docs/retail-slice-1-store-commerce.md.
  storeMemberships  StoreMember[]
}

// Silenciar notis de UNA serie puntual (override del toggle global "tomos
// nuevos"). Si hay fila → el usuario NO quiere notis de esa serie.
model SeriesNotifMute {
  userId    String
  anilistId Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, anilistId])
  @@index([anilistId])
}

// Suscripción Web Push (un dispositivo/navegador del usuario).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Preferencias de notificación por usuario (un toggle por categoría).
model NotificationPref {
  userId    String  @id
  newVolume Boolean @default(true) // "tomo nuevo" de tus series
  reissue   Boolean @default(true) // reedición de un tomo agotado que te falta
  wishlist  Boolean @default(true) // novedades de tus deseados (salió en AR)
  social    Boolean @default(true) // reacciones y comentarios en tu actividad
  friends   Boolean @default(true) // solicitudes / aceptaciones de amistad
  contributions Boolean @default(true) // novedades de tus contribuciones al catálogo
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dedup de las notis disparadas desde IvreaRelease (próximo tomo / reedición):
// el snapshot se reemplaza en cada corrida, así que la idempotencia vive acá.
model IvreaReleaseNotified {
  key       String   @id // "<kind>:<workId>:<volume>:<YYYY-MM-DD>"
  createdAt DateTime @default(now())
}

// Notificación in-app (reacción/comentario en tu actividad, etc.).
model Notification {
  id         Int      @id @default(autoincrement())
  userId     String // destinatario
  type       String // REACTION | COMMENT | FRIEND_REQUEST | FRIEND_ACCEPTED
  actorName  String
  activityId Int?
  anilistId  Int?
  text       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Amistad entre dos usuarios (con solicitud + aceptación).
model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// Evento de actividad de un usuario (para el feed de amigos).
model Activity {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // ADDED_EDITION | MARKED_READ | COMPLETED
  anilistId  Int?
  title      String?
  coverImage String?
  detail     String? // ej. la edición
  createdAt  DateTime @default(now())

  reactions ActivityReaction[]
  comments  ActivityComment[]

  @@index([userId, createdAt])
}

model ActivityReaction {
  id         Int    @id @default(autoincrement())
  activityId Int
  userId     String
  emoji      String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}

model ActivityComment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     String
  text       String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Nota y puntaje personal de una serie (independiente de tenerla en la colección).
model UserNote {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId Int
  rating    Int? // 1-10
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([userId, anilistId])
}

// Lista de deseados: series que el usuario quiere comprar (aparte de la colección).
model WishlistItem {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anilistId  Int
  // Deseado POR EDICIÓN: "" = legacy/cualquiera; "ivrea"/"viz"/… = edición puntual.
  // Así las notis y "ya salió" no mezclan ediciones de la misma serie.
  editionKey String  @default("")
  publisher  String? // label de la editorial deseada (display)
  region     String? // AR | INT | … (para la bandera)
  title      String
  coverImage String
  // Ya avisamos "salió en Argentina" por esta deseada (idempotente, evita
  // re-notificar y la tormenta retroactiva en la 1ra corrida).
  notifiedAvailable Boolean @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, anilistId, editionKey])
}

// Historial de compras del usuario (lo que antes llevaba en un Excel).
// Una compra = una transacción (fecha + tienda + estado) con uno o más tomos.
model Purchase {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  store    String? // dónde lo compraste
  status   String  @default("RECEIVED") // PENDING | SHIPPED | DELAYED | RECEIVED | CANCELLED
  note     String?
  discount Float   @default(0) // % de descuento sobre el subtotal (ej. Crumb)

  purchasedAt DateTime  @default(now()) // fecha de compra/pedido
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  items PurchaseItem[]

  @@index([userId])
}

// Un tomo dentro de una compra. El precio vive acá (precio por tomo); el total
// de la compra es la suma de sus ítems.
model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  title      String // título del manga (display)
  anilistId  Int? // link opcional a la serie
  coverImage String? // portada, para mostrar y para auto-agregar a colección
  volume     Int? // tomo, opcional
  edition    String? // edición/editorial, opcional
  price      Float // precio pagado por este tomo (ARS)
  status     String  @default("RECEIVED") // PENDING | SHIPPED | DELAYED | RECEIVED | CANCELLED (por tomo)

  @@index([purchaseId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Log de inicios de sesión (para el panel admin).
model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    String?
  name      String?
  email     String?
  image     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Dominio ---

// Una serie en la colección del usuario. La info de tomos/lectura vive en cada
// edición trackeada (un usuario puede seguir varias ediciones de la misma serie).
model Manga {
  id        Int    @id @default(autoincrement())
  anilistId Int // id de AniList
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  romajiTitle  String
  englishTitle String?
  nativeTitle  String?
  coverImage   String

  // Referencia (no editable): totales de AniList / MangaUpdates.
  apiTotalVolumes Int?
  muVolumes       Int?

  editions TrackedEdition[]

  createdAt DateTime @default(now())

  @@unique([userId, anilistId])
}

// Una edición trackeada de una serie (Ivrea, Panini, Ovni, japonesa estándar…),
// con su propio conteo de tomos, progreso y estado de lectura.
model TrackedEdition {
  id      Int   @id @default(autoincrement())
  mangaId Int
  manga   Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  key       String // "ivrea" | "panini" | "ovni" | "mu-volumes" | "mu-kanzenban" | …
  label     String // nombre legible: "Ivrea Argentina", "Edición estándar (japonesa)"
  publisher String?
  slug      String?
  region    String  @default("AR") // AR | JP | INT

  totalVolumes Int
  status       String @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED

  readingStatus String  @default("UNREAD") // UNREAD | READING | READ
  readingVolume Int?

  ownedVolumes OwnedVolume[]

  createdAt DateTime @default(now())

  @@unique([mangaId, key])
}

model OwnedVolume {
  id Int @id @default(autoincrement())

  editionId Int
  volume    Int

  edition TrackedEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, volume])
}

// Caché de las ediciones resueltas por serie (AniList id). Evita re-scrapear
// editoriales + MangaUpdates en cada carga del detalle.
model EditionsCache {
  anilistId Int      @id
  data      Json
  updatedAt DateTime @updatedAt
}

// Índice de mangakas (autores) para el listado alfabético global. Se deriva
// escaneando los mangas más populares de AniList (su API no permite listar/
// ordenar autores). Lo reconstruye un cron semanal (y `npm run crawl`).
model Mangaka {
  id        Int      @id // id de staff de AniList
  name      String
  normName  String // nombre normalizado, para ordenar/paginar alfabéticamente
  updatedAt DateTime @updatedAt

  @@index([normName])
}

// Estado interno key/value (p. ej. el cursor del scan de mangakas, para que el
// cron retome el escaneo profundo de a poco sin pegarle de más a AniList).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Feature flags: estado (on/off) por flag, editable desde admin sin redeploy.
// La metadata (label/descripción/default) vive en lib/featureFlags.ts (registro
// tipado); acá solo guardamos el override.
model FeatureFlag {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
}

// Fuentes (Whakoom/Ivrea) descartadas a mano: entradas duplicadas o
// problemáticas que ya curaste/borraste. El crawl/import NO las vuelve a traer.
// `source` = "whakoom" | "ivrea"; `sourceId` = whakoomId, o slug de Ivrea.
model RejectedSource {
  source    String
  sourceId  String
  reason    String?
  createdAt DateTime @default(now())

  @@id([source, sourceId])
}

// Contador de rate limiting (ventana fija). `key` = "<accion>:<userId|ip>".
// Backed por DB para que funcione en serverless (varias instancias). Las filas
// vencidas se pisan en el próximo hit; no requieren limpieza activa.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

// Identidad propia de obra (catálogo local). Reemplaza progresivamente a
// `anilistId` como llave del dominio. Se puebla desde el import/crawl; `anilistId`
// queda como referencia opcional de enriquecimiento, no como llave.
model Work {
  id         Int      @id @default(autoincrement())
  title      String // título principal que mostramos (display: ES > EN > romaji)
  normTitle  String // normalizado para agrupar ediciones y para búsqueda
  // Nombres multi-idioma. `originalTitle` ES el romaji (llave de match con
  // MangaUpdates / MangaDex). Los demás se completan desde MD/AniList una vez que
  // la obra tiene identidad externa. Ver docs/analisis-sistema-datos.md.
  originalTitle String? // romaji (titleRomaji)
  titleEn       String? // título en inglés (VIZ / AniList english)
  titleNative   String? // título nativo japonés (kanji/kana; AniList native / MD ja)
  coverImage String?
  author     String? // autor PRINCIPAL (historia); semilla de la ficha + índice de autores
  assistants String? // asistentes/colaboradores (ayuda a desambiguar homónimos)
  // Créditos por ROL (más allá del autor principal): [{name, role, order}].
  // role = STORY | ART | ASSISTANT | SCRIPT | PENCILS | INK | COLOR | LETTER | UNKNOWN.
  // Manga: STORY/ART desde MU. Cómics: script/ink/color cuando haya fuente (GCD dif.).
  credits    Json?
  synopsis   String? // DEPRECADO: usar synopsisEs/synopsisEn. Se mantiene de transición.
  // Sinopsis por idioma (tabs ES/EN en la ficha). La nativa de la fuente manda
  // (ES de Ivrea/Whakoom, EN de MU/MD/AniList); si falta una, se traduce de la
  // otra con LLM y se marca `...Auto`. Ver docs/analisis-sistema-datos.md.
  synopsisEs   String?
  synopsisEn   String?
  synopsisEsAuto Boolean @default(false) // la ES es traducción automática (no oficial)
  synopsisEnAuto Boolean @default(false) // la EN es traducción automática
  genres     String[] // géneros CANÓNICOS (es) para filtrar; ver lib/genres.ts
  // Géneros crudos de MU/MD (en inglés) antes de mapear: backup para re-mapear
  // sin re-enriquecer.
  rawGenres   String[]
  // Demografía (Shonen/Shojo/Seinen/Josei/Kodomo): eje aparte del género.
  demographic String?
  // Tipo de contenido. Define qué se muestra/oculta (ej. Panini mezcla manga y
  // cómics Marvel/DC). MANGA por defecto; COMIC se clasifica por no matchear
  // MU/MD + heurística occidental. Override manual en el editor admin (curated).
  // Valores: MANGA | COMIC | LIGHT_NOVEL | ARTBOOK | DATABOOK | OTHER.
  type        String  @default("MANGA")
  // Links de lectores LEGALES (MANGA Plus, VIZ…), curados por AniList (type
  // STREAMING). Array de {url, site, language}. Se rellena por batch (sin AniList
  // en runtime). El botón "Leer en MangaDex" se deriva del mdId, no se guarda acá.
  readingLinks Json?
  // Cuándo se enriqueció desde MU/MD (null = pendiente). Para el job batch.
  enrichedAt DateTime?
  upcoming   Boolean  @default(false) // "Próximo a salir" en AR (preventa/anunciada)
  // Fecha estimada de salida, BORROSA y manual: "2026" (solo año) o "2026-07"
  // (mes+año). Whakoom/Ivrea a veces solo dan el año o el mes.
  releaseLabel String?
  // Identidad externa estable: el matcheo se ancla acá (no en el título). Se
  // resuelve UNA vez (por romaji + autor) y se reusa → re-match idempotente.
  anilistId  Int?     @unique // referencia externa opcional (snapshot/enriquecimiento)
  muId       String?  @unique // id de MangaUpdates (series id; los nuevos exceden INT4)
  mdId       String?  @unique // id de MangaDex (uuid)
  // Campos editados a mano por el admin (ej. "coverImage", "author"): NINGÚN job
  // los pisa, ni siquiera los `--force`. Ver updateWorkAction.
  curated    String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  editions PublisherEdition[]

  // Identidades del catálogo que designan a esta obra (contenido). Relación virtual: la
  // FK vive en CatalogIdentity.designatedWorkId. A lo sumo UNA identidad ACTIVA por obra
  // (índice parcial en la migración). Ver docs/identity-confer-slice.md.
  identities CatalogIdentity[]

  // Absorción de contenido (ADR-008): si != null, este Work fue ABSORBIDO por otro y queda
  // detached (sus ediciones se re-parentaron). `absorbedIntoId != null` ES la fuente normativa
  // del estado "absorbido" (sin columna duplicada). Self-FK Restrict (perpetuidad: no se borra un
  // sobreviviente con absorbidos apuntándolo). CHECK de no-autoabsorción en la migración (crudo).
  // Ver docs/catalog-work-absorption-slice.md.
  absorbedIntoId Int?
  absorbedInto   Work?  @relation("WorkAbsorption", fields: [absorbedIntoId], references: [id], onDelete: Restrict)
  absorbedWorks  Work[] @relation("WorkAbsorption")

  @@index([normTitle])
  @@index([absorbedIntoId])
}

// Índice de catálogos de las editoriales (poblado por scripts/crawl.ts).
// Permite resolver ediciones con un lookup rápido en vez de scrapear en vivo.
model PublisherEdition {
  id        Int      @id @default(autoincrement())
  publisher String // "Ivrea Argentina" | "Panini Argentina" | "Ovni Press"
  slug      String // slug en el sitio de la editorial
  title     String // título tal como lo lista la editorial
  normTitle String // título normalizado, para matching
  anilistId Int? // serie de AniList, backfilleada al resolver una ficha (link directo)
  // Obra solo-nacional (no existe en AniList): anilistId null a propósito, no
  // cuenta como "sin mapear". P. ej. cómics occidentales que vende Ivrea.
  nationalOnly Boolean @default(false)
  volumes      Int
  // Conteo de tomos editado a mano por el admin: el crawl (upsertPublisherEdition)
  // NO lo pisa cuando está en true. Para corregir conteos que la fuente trae mal.
  volumesLocked Boolean @default(false)
  // Sinopsis de ESTA edición, en su idioma (ES de Ivrea/Whakoom, EN de VIZ). Para
  // obras con edición ES + EN (ej. Rai Rai Rai) que no deben pisarse entre sí.
  synopsis        String?
  // Último conteo de tomos por el que ya se notificó "tomo nuevo". 0 = sin
  // baselinear (la primera vez se baselinea en silencio, sin notificar).
  notifiedVolumes Int     @default(0)
  status          String?
  url             String
  // Idioma/país de la edición (para ediciones internacionales). Las existentes
  // son español (AR). Ver docs/plan-viz-en.md.
  language        String   @default("es") // "es" | "en" | "ja"
  country         String? // "AR" | "ES" | "US" | "JP" | …
  // Id de la edición en Whakoom (de /ediciones/<id>/…). Identidad fuerte: sus
  // relaciones ya están debugueadas, así desambiguamos sin depender del título.
  whakoomId       String?  @unique
  // Obra del catálogo local a la que pertenece (agrupa varias ediciones). Se
  // backfillea; mientras tanto puede ser null.
  workId          Int?
  work            Work?    @relation(fields: [workId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt

  volumesList Volume[]

  @@unique([publisher, slug])
  @@index([normTitle])
  @@index([workId])
}

// Tomo individual de una edición. Per-tomo guardamos el id de Whakoom (llave
// estable) y dejamos `isbn` listo para llenar desde las páginas de la editorial
// (Whakoom no publica ISBN; las editoriales sí suelen tenerlo).
model Volume {
  id        Int              @id @default(autoincrement())
  editionId Int
  edition   PublisherEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  number         Int
  whakoomComicId String? // id del tomo en Whakoom (/comics/<id>/…)
  isbn           String?
  coverImage     String?
  updatedAt      DateTime @updatedAt

  @@unique([editionId, number])
  @@index([isbn])
}

// Identidad del catálogo (el "handle"): asa durable y delgada que designa un contenido.
// NO es contenido (no tiene título/autor/sinopsis); esos viven en Work. NO posee sus
// referencias externas (viven en IdentityExternalReference, propiedad del namespace).
// Este slice SOLO confiere (nace ACTIVE); Fusionar/Partir/Retirar/redirección NO existen
// todavía. El handle (`id`, sequence) es fresco por construcción y jamás se reusa (las
// filas no se borran). Invariantes globales enforzados por índices únicos en la migración
// (designación única entre ACTIVE = índice parcial; unicidad de referencia). Ver
// docs/identity-confer-slice.md y el Glosario Normativo del Dominio.
model CatalogIdentity {
  id               Int      @id @default(autoincrement()) // el handle
  state            String   @default("ACTIVE") // ACTIVE (RETIRED/REDIRECTED son conceptuales; no se producen acá)
  contentClass     String // clase de contenido (coherente con Work.type)
  designatedWorkId Int // el contenido que designa
  decisionId       String   @unique // identificador de la Decisión que la confirió
  // Huella semántica canónica de la Decisión (contenido + clase + referencias semilla como
  // conjunto ordenado). Permite distinguir "misma decisión" (idempotente) de "mismo decisionId
  // reusado con intención divergente" (rechazo), sin comparar tablas relacionadas en el replay.
  decisionFingerprint String
  // Redirección de fusión (ADR-008/009): si `state='REDIRECTED'`, esta identidad fue ABSORBIDA por otra
  // y `redirectsToId` apunta a la SOBREVIVIENTE (un salto; v1 no encadena). Invariante ACTIVE ⟺
  // redirectsToId null (CHECK crudo en la migración). Conserva `designatedWorkId` histórico (deja de
  // designar contenido activo porque el índice parcial es WHERE state='ACTIVE'). Ver docs/identity-merge-slice.md.
  redirectsToId Int?
  // Procedencia de la Decisión Fusionar que redirigió ESTA fila (vive en la ABSORBIDA, la que transiciona).
  // NO reusa las columnas de Conferir (semántica distinta). Único (idempotencia); NULL en filas ACTIVE.
  mergeDecisionId          String?  @unique
  mergeDecisionFingerprint String?
  createdAt                DateTime @default(now())

  designatedWork Work                        @relation(fields: [designatedWorkId], references: [id], onDelete: Restrict)
  externalRefs   IdentityExternalReference[]
  // Self-relación de redirección (Fusionar). La FK vive en `redirectsToId`. `redirectedFrom` son las
  // identidades que redirigen HACIA esta (v1 prohíbe encadenar sobre una ya redirigida).
  redirectsTo    CatalogIdentity?  @relation("IdentityRedirect", fields: [redirectsToId], references: [id], onDelete: Restrict)
  redirectedFrom CatalogIdentity[] @relation("IdentityRedirect")

  // La designación única entre identidades ACTIVE es un índice PARCIAL (WHERE state='ACTIVE')
  // que Prisma no expresa en el DSL: se crea por SQL crudo en la migración. Los CHECK de coherencia
  // estado⇔redirección y de pareo de procedencia también son crudos (ver migración).
  @@index([designatedWorkId])
  @@index([redirectsToId])
}

// Asociación referencia externa → identidad (propiedad del namespace / Registro, no de
// Identity — Alternativa B). Una referencia (provider, externalId) resuelve a lo sumo hacia
// UNA identidad: la unicidad la enforcea `@@unique([provider, externalId])`.
model IdentityExternalReference {
  id         Int      @id @default(autoincrement())
  identityId Int
  provider   String
  externalId String
  // Estado denormalizado del destino, SIEMPRE 'ACTIVE' (ADR-009). Es la mitad "estado" de la FK
  // COMPUESTA `(identityId, identityState) → CatalogIdentity(id, state)` (cruda en la migración,
  // ON UPDATE RESTRICT + CHECK = 'ACTIVE'), que garantiza declarativamente que una referencia solo
  // resuelve hacia una Identity ACTIVE y fuerza mover las referencias antes de redirigir. NO es
  // sincronización manual del estado real: es un detalle de persistencia (default en Conferir,
  // constante en Asociar), y la FK es la garantía. No forma parte de la decisión ni del fingerprint.
  identityState String @default("ACTIVE")
  // Decisión Asociar que creó esta referencia (idempotencia + reuso divergente). NULL en las
  // referencias semilla creadas durante Conferir (su procedencia es la decisión de la identidad).
  // El índice único permite múltiples NULL (Postgres trata NULL como distinto).
  decisionId          String? @unique
  decisionFingerprint String?
  createdAt           DateTime @default(now())

  identity CatalogIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([identityId])
}

// Snapshot de las salidas anunciadas en ivrea.com.ar/proximas/ (lanzamiento,
// debut, tomo único o reedición de tomo agotado), con su fecha. La refresca
// (reemplazo total) el cron mensual; alimenta la fecha de salida en la ficha y,
// más adelante, las notis de próximo tomo / reedición. `slug`/`anilistId`/
// `editionId` quedan null en debuts que linkean a /news/ (sin ficha aún).
model IvreaRelease {
  id          Int       @id @default(autoincrement())
  slug        String?
  title       String
  volume      Int?
  kind        String // "volume" | "debut" | "oneshot" | "reissue"
  releaseDate DateTime?
  editionId   Int?
  anilistId   Int?
  updatedAt   DateTime  @updatedAt

  @@index([anilistId])
  @@index([editionId])
  @@index([releaseDate])
}

// "Esta editorial NO va en esta serie": para desvincular ediciones que la
// resolución en vivo engancha mal por título (p. ej. ids duplicados de AniList).
model EditionExclusion {
  anilistId Int
  publisher String

  @@id([anilistId, publisher])
}

// Override manual del término de búsqueda de "Comprar en Crumb" por serie,
// para cuando el título automático no encuentra el producto en Crumb.
model CrumbMapping {
  anilistId Int      @id // 1 override por serie
  query     String // término de búsqueda a usar en Crumb
  updatedAt DateTime @updatedAt
}

// Registro de corridas de jobs (imports, resolves, crons): para ver qué pasó
// y, sobre todo, qué se salteó y por qué (visibilidad que nos faltó).
model JobRun {
  id         Int      @id @default(autoincrement())
  kind       String // "whakoom-import" | "resolve" | "mangakas-cron" | …
  label      String? // detalle (editorial, URL, etc.)
  status     String   @default("OK") // OK | ERROR
  processed  Int      @default(0)
  imported   Int      @default(0)
  mapped     Int      @default(0)
  skipped    Int      @default(0)
  summary    Json? // motivos de skip agrupados, etc.
  error      String?
  startedAt  DateTime
  finishedAt DateTime @default(now())

  @@index([kind])
}

// Comiquerías / tiendas locales. Curadas por el dueño o propuestas por usuarios.
model Store {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?
  city        String?
  province    String?
  phone       String?
  hours       String?
  website     String?
  social      String?
  status      String   @default("APPROVED") // APPROVED | PENDING
  submittedBy String? // userId que la propuso (si vino de la comunidad)
  createdAt   DateTime @default(now())

  // Retail: capacidad comercial OPCIONAL (una tienda del directorio puede no ser comercial). Relación
  // VIRTUAL (la FK vive en StoreCommerceProfile.storeId); no agrega columnas a Store. Ver
  // docs/retail-slice-1-store-commerce.md.
  commerceProfile StoreCommerceProfile?

  @@index([status])
}

// ============================================================================
// Retail / Preventas — dominio comercial (Slice 1: infraestructura de tienda).
// SATÉLITE aditivo del directorio `Store`: NO modifica su tabla (solo relaciones virtuales). Todavía
// NO hay campañas/ofertas/órdenes/reservas. Ver docs/retail-slice-1-store-commerce.md.
// ============================================================================

// Capacidad comercial de una tienda (1:1 con Store). Su ausencia = tienda no comercial. Aporta el `slug`
// direccionable de las rutas comerciales y los datos que las preventas futuras usarán (pago/retiro/WA).
model StoreCommerceProfile {
  id                  Int      @id @default(autoincrement())
  storeId             Int      @unique
  slug                String   @unique // llave de ruta comercial: /tiendas/<slug>/admin
  enabled             Boolean  @default(false) // capacidad comercial activa (pausable)
  whatsapp            String?
  paymentAlias        String?
  paymentInstructions String?
  pickupInstructions  String?
  publicDescription   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  members StoreMember[]
}

// Quién administra la operación comercial de una tienda. Los CLIENTES nunca son miembros. Sin permisos
// granulares todavía: rol OWNER | STAFF. Cuelga del perfil comercial (agregar miembros presupone perfil).
model StoreMember {
  id        Int      @id @default(autoincrement())
  profileId Int
  userId    String
  role      String // OWNER | STAFF
  createdAt DateTime @default(now())

  profile StoreCommerceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([userId])
}

// Obra de un autor independiente/local, subida por un usuario y moderada por
// el dueño (aprobar/rechazar), al estilo de las tiendas de la comunidad.
model IndieWork {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  synopsis    String?
  coverUrl    String? // URL de portada (MVP: link externo)
  buyUrl      String? // dónde comprar/leer
  social      String? // redes del autor
  status      String   @default("PENDING") // PENDING | APPROVED
  submittedBy String? // userId que la subió
  createdAt   DateTime @default(now())

  @@index([status])
}

// Reportes/correcciones de datos enviados por usuarios (revisión del dueño).
model Report {
  id         Int      @id @default(autoincrement())
  userId     String? // quién lo reportó (si está logueado)
  mangaId    Int? // id de AniList del manga
  mangaTitle String
  message    String
  status     String   @default("PENDING") // PENDING | RESOLVED
  createdAt  DateTime @default(now())
}

// Audit log del Mutation Framework. 1:1 con AuditEntry (lib/mutations/audit,
// schema CONGELADO v1). Append-only: una fila por fase (attempt/success/failure/
// skipped); el correlationId conecta todas las fases de una corrida. `affected`,
// `summary` y `error` se aplanan en columnas para poder consultarlos. La
// idempotencia se resuelve leyendo filas `success` por `mutationKey`.
model MutationLog {
  id                Int      @id @default(autoincrement())
  schemaVersion     Int
  frameworkVersion  Int
  definitionVersion Int
  phase             String // attempt | success | failure | skipped
  name              String // operación (ej. "mergeWork")
  kind              String // ej. "MERGE"
  actorType         String // script | user | cron | admin | import
  actorId           String
  env               String // production | staging | preview | development
  correlationId     String
  requestId         String?
  dryRun            Boolean
  // affected (best-effort; ver decisión "pragmatic mode" en mutation-framework.md)
  creates           Int?
  updates           Int?
  deletes           Int?
  entities          String[]
  irreversible      Boolean?
  summaryDomain     String?
  summaryHuman      String?
  warnings          String[]
  mutationKey       String?
  mutationScope     String?
  durationMs        Int?
  errorName         String?
  errorMessage      String?
  at                DateTime

  @@index([correlationId])
  @@index([name, at])
  @@index([mutationKey])
}

// ============================================================================
// Community Contributions — bounded context ADITIVO (ADR-006).
// NO toca Work/Edition/Volume/User/MutationLog/Notification (salvo la columna
// NotificationPref.contributions). Refs cross-BC (Work/Edition/Volume/User/
// MutationLog/assets) = BLANDAS (Int?/String?, sin FK). FKs SOLO internas al BC.
// Enum-like = String (convención del repo, sin enums Prisma). Los CHECKs y las
// invariantes complejas van fuera del schema (SQL manual / application). Ver
// docs/community-contributions-first-migration-plan.md.
// ============================================================================

// Aggregate root: identidad opaca del sujeto propuesto + estado de moderación.
// NO es una obra del catálogo; una propuesta pendiente no existe como Work.
model CatalogProposal {
  id                   Int      @id @default(autoincrement())
  family               String // ALTA | CORRECCION | REPORTE
  targetKind           String // NEW_WORK|NEW_EDITION|NEW_VOLUME|WORK|EDITION|VOLUME|STRUCTURAL
  refWorkId            Int? // soft ref catálogo (target/parent/reporte-A)
  refEditionId         Int? // soft ref catálogo
  refVolumeId          Int? // soft ref catálogo
  refWorkBId           Int? // soft ref catálogo (DUPLICATE contraparte)
  relationKind         String? // DUPLICATE | BAD_MERGE (solo STRUCTURAL)
  contentClass         String // MANGA | COMIC — autoritativo estructural, INMUTABLE
  status               String   @default("SUBMITTED")
  version              Int      @default(0) // optimistic locking
  relatedProposalId    Int? // soft ref a otra Proposal (advisory; CHECK != id manual)
  originatorUserId     String? // soft ref User (denorm; null p/ anonimización)
  createIdempotencyKey String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  contributions ProposalContribution[]
  infoRequests  ProposalInfoRequest[]
  subscriptions ProposalSubscription[]
  preflightKeys ProposalPreflightKey[]
  resolution    ResolutionRecord?

  @@index([status])
  @@index([originatorUserId])
  @@index([contentClass])
  @@index([refWorkId])
  @@index([refEditionId])
  @@index([refVolumeId])
}

// Envío append-only atribuido. La primera contribución origina la Proposal.
// Contenido inmutable; solo mutan visibility y withdrawnAt (metadata). La
// disposición (aceptada/parcial/…) es DERIVADA, no se persiste.
model ProposalContribution {
  id                   Int       @id @default(autoincrement())
  proposalId           Int
  authorId             String? // soft ref User; null p/ anonimización → "Otra persona"
  visibility           String    @default("VISIBLE") // VISIBLE | OCULTA | EN_CUARENTENA
  withdrawnAt          DateTime? // retiro autoritativo (null = ABIERTA)
  answersInfoRequestId Int? // FK interna (dirección autoritativa), onDelete: SetNull
  idempotencyKey       String?   @unique
  createdAt            DateTime  @default(now())

  proposal           CatalogProposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  answersInfoRequest ProposalInfoRequest? @relation(fields: [answersInfoRequestId], references: [id], onDelete: SetNull)
  claims             ProposalClaim[]

  @@index([proposalId, createdAt])
  @@index([authorId])
  @@index([answersInfoRequestId])
}

// Afirmación (attributeKind, value) — unidad de conocimiento y de resolución.
// attributeKind/contractVersion/claimOperation/value INMUTABLES; result y su
// metadata de resolución son mutables.
model ProposalClaim {
  id               Int       @id @default(autoincrement())
  contributionId   Int
  attributeKind    String
  contractVersion  Int
  claimOperation   String // SET|ADD|REMOVE|MARK_UNKNOWN|MARK_NOT_APPLICABLE
  value            Json? // tipado por (attributeKind, contractVersion); null si MARK_*
  result           String    @default("PROPUESTA") // PROPUESTA|ACEPTADA|NO_USADA|RETIRADA
  resultReason     String? // procedencia|corroboracion | desplazada|descartada|rechazada
  resolvedAt       DateTime?
  resolvedByUserId String? // soft ref User
  promotedAssetRef String? // soft ref a asset oficial (URL R2) p/ portada aceptada
  createdAt        DateTime  @default(now())

  contribution       ProposalContribution     @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  evidenceReferences ClaimEvidenceReference[]
  evidenceArtifacts  ClaimEvidenceArtifact[]

  @@index([contributionId, result])
}

// Evidencia por referencia (VO inmutable): URL / ISBN / fuente estructurada.
model ClaimEvidenceReference {
  id        Int      @id @default(autoincrement())
  claimId   Int
  type      String // URL | ISBN | SOURCE_REF
  value     String
  strength  String // STRONG | MEDIUM | WEAK
  createdAt DateTime @default(now())

  claim ProposalClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, type, value])
}

// Evidencia por artefacto (imagen subida). LATENTE en MVP-A: la tabla existe pero
// NO se crean filas desde producción hasta habilitar el pipeline de uploads (MVP-B).
// Contenido inmutable; estado de moderación mutable. CHECKs de lifecycle → MVP-B.
model ClaimEvidenceArtifact {
  id                Int       @id @default(autoincrement())
  claimId           Int
  status            String    @default("EN_CUARENTENA") // EN_CUARENTENA|DISPONIBLE|BLOQUEADA
  storageKey        String // opaca (key de R2); NO URL firmada
  hash              String // content hash (tombstone/audit)
  detectedMime      String?
  sizeBytes         Int?
  scanResult        String?
  blockedReason     String?
  scheduledDeleteAt DateTime?
  bytesDeletedAt    DateTime?
  promotedAssetRef  String? // soft ref a asset oficial (URL R2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  claim ProposalClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledDeleteAt])
}

// Pedido de información del moderador. answersInfoRequestId (en Contribution) es la
// dirección autoritativa; targetContributionId acá es una ref BLANDA (rompe el ciclo).
model ProposalInfoRequest {
  id                   Int       @id @default(autoincrement())
  proposalId           Int
  scope                String // PROPOSAL | CONTRIBUTION
  targetUserId         String? // soft ref User
  targetContributionId Int? // soft ref interna (sin FK; app valida misma Proposal)
  prompt               String
  privateNote          String? // solo moderador
  status               String    @default("ABIERTO") // ABIERTO | ANSWERED
  openedByUserId       String // soft ref User
  answeredAt           DateTime?
  idempotencyKey       String?   @unique // idempotencia fuerte de RequestProposalInfo (nullable p/ filas históricas)
  createdAt            DateTime  @default(now())

  proposal               CatalogProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  answeringContributions ProposalContribution[] // back-relation de answersInfoRequestId

  @@index([proposalId, status])
}

// Interés/aviso en una propuesta. Aggregate aparte; no aporta datos.
model ProposalSubscription {
  id         Int      @id @default(autoincrement())
  proposalId Int
  userId     String // soft ref User
  status     String   @default("ACTIVE") // ACTIVE | CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proposal CatalogProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([userId, proposalId])
  @@index([proposalId, status])
}

// Registro inmutable del acto de resolución (1 por Proposal). publicReason y
// privateNote viven SOLO acá. Refs de applied/superseding/mutation/primaryTitle = blandas.
model ResolutionRecord {
  id                    Int      @id @default(autoincrement())
  proposalId            Int      @unique
  outcome               String // ACEPTADA|RECHAZADA|SUPERSEDED|ABANDONADA
  actorType             String // HUMAN | SYSTEM | RECONCILE
  moderatorUserId       String? // soft ref User
  resolvedAt            DateTime @default(now())
  publicReason          String?
  privateNote           String? // solo moderador
  appliedWorkId         Int? // soft ref catálogo
  appliedEditionId      Int? // soft ref catálogo
  appliedVolumeId       Int? // soft ref catálogo
  supersedingProposalId Int? // soft ref a otra Proposal
  supersededReason      String? // IMPORT | MODERATION | ANOTHER_PROPOSAL
  mutationCorrelationId String? // soft ref MutationLog.correlationId
  overrideSummary       Json?
  primaryTitleClaimId   Int? // soft ref interna (sin FK; app valida misma Proposal + ACEPTADA)
  reconcileMeta         Json?

  proposal CatalogProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

// Índice derivado y recomputable de preflight (NO verdad del dominio). Se recomputa
// desde las claims ACTIVAS; el preflight filtra por status de la Proposal.
model ProposalPreflightKey {
  id         Int    @id @default(autoincrement())
  proposalId Int
  keyType    String // NORM_TITLE | ROMAJI | ISBN | EXTERNAL
  keyValue   String

  proposal CatalogProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, keyType, keyValue])
  @@index([keyType, keyValue])
}
