generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  mangas   Manga[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Dominio ---

model Manga {
  id        Int    @id @default(autoincrement())
  anilistId Int // id de AniList
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  romajiTitle  String
  englishTitle String?
  nativeTitle  String?
  coverImage   String

  // Totales de tomos por fuente (prioridad en lib/getTotalVolumes.ts)
  apiTotalVolumes    Int?
  muVolumes          Int?
  customTotalVolumes Int?

  // Datos de la edición local (Ivrea / Panini / Ovni)
  publisher        String?
  editionSlug      String?
  argentinaStatus  String?
  argentinaVolumes Int?
  japanStatus      String?
  japanVolumes     Int?
  nextVolume       Int?

  status String @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED (según tomos que tenés)

  // Lectura (eje independiente de "tener" el tomo)
  readingStatus String @default("UNREAD") // UNREAD | READING | READ
  readingVolume Int?

  ownedVolumes OwnedVolume[]

  createdAt DateTime @default(now())

  // Una serie de AniList aparece una vez por usuario.
  @@unique([userId, anilistId])
}

model OwnedVolume {
  id Int @id @default(autoincrement())

  mangaId Int
  volume  Int

  manga Manga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, volume])
}

// Reportes/correcciones de datos enviados por usuarios (revisión del dueño).
model Report {
  id         Int      @id @default(autoincrement())
  userId     String? // quién lo reportó (si está logueado)
  mangaId    Int? // id de AniList del manga
  mangaTitle String
  message    String
  status     String   @default("PENDING") // PENDING | RESOLVED
  createdAt  DateTime @default(now())
}
